# ============================================================================
# CONFIGURATION — TICKET EN LIGNE (fichier local, NON versionné)
# Dupliquer ce fichier en `.env` et renseigner les valeurs du client.
# ============================================================================

# Identifiant société (lg_socid) — requis par la plupart des endpoints publics
SOC_ID=

# Code société (lg_soccode) — optionnel, selon les besoins backend
SOC_CODE=

# Numéro d'assistance client affiché dans l'en-tête
CONTACT_PHONE=

# URL de base de l'API (optionnel : déduit automatiquement de l'environnement)
# VITE_API_BASE_URL=http://synapsepcdev07:9081/s2q/
